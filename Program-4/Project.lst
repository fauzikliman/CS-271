 00000277			numberIsComposite:
 00000277  C6 05 000001BE R		mov		testNumberIsComposite, 1
	   01
 0000027E			endIsComposite:
 0000027E  61				popad
 0000027F  C3				ret
 00000280			IsComposite ENDP

				; Procedure to calculate the amount digits in the composite number
				; Recieves: compositeNumber, compositeNumberLength are global variables
				; Returns: global compositeNumberLength = number of digits in compositeNumber
				; Preconditions: none
				; Registers changed: none
 00000280			CalculateCompositeNumberLength PROC
 00000280  60				pushad

					; Divide the composite number by 10, incrementing the amount of digits
					; it has until the quotient is 0
 00000281  A1 000001D3 R		mov		eax, compositeNumber
 00000286  BB 0000000A			mov		ebx, 10
 0000028B  B9 00000001			mov		ecx, 1

					; Divide the composite number repeatedly until the quotient is 0,
					; incrementing the amount of digits it has each iteration
 00000290			begLoop:
 00000290  99				cdq
 00000291  F7 F3			div		ebx
					; Stop dividing if the quoteint is 0
 00000293  83 F8 00			cmp		eax, 0
 00000296  74 03			je		endLoop
					; Increment the amount of digits the composite number has
 00000298  41				inc		ecx
 00000299  EB F5			jmp		begLoop
 0000029B			endLoop:
					; Update the compositeNumberLength variable
 0000029B  89 0D 000001D7 R		mov		compositeNumberLength, ecx
 000002A1  61				popad
 000002A2  C3				ret

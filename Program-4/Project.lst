 0000008C  60				pushad
 0000008D			begUserInput:
					; Display prompt asking for number of composites to show
 0000008D  BA 000000C4 R		mov		edx, OFFSET numberOfCompositesPrompt
 00000092  E8 00000000 E		call	WriteString


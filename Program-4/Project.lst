	   000003E8
 000000D6  7F 09			jg		inputInvalid

					; Mark input as valid by moving true (1) into eax
 000000D8  C6 05 000001B9 R		mov		userInputValid, 1
	   01
 000000DF  EB 07			jmp		endValidate

					; Mark input as invalid by move false (0) into eax

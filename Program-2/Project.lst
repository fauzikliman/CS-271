					; Set the loop counter the amount terms the user wants
 000000B8  8B C8			mov		ecx, eax
 000000BA			begFibLoop:
 000000BA  A1 0000015A R		mov		eax, termA
 000000BF  03 05 0000015E R		add		eax, termB
 000000C5  E8 00000000 E		call	WriteDec

					; Set termB to termA, set termA to the term sum
 000000CA  8B 1D 0000015A R		mov		ebx, termA
 000000D0  89 1D 0000015E R		mov		termB, ebx
 000000D6  A3 0000015A R		mov		termA, eax

					; Find out how many digits are in the sum
					; The amount of digits in a number is the amount of times you can
					; recursively divide that number by 10 till a quotient of 0 is reached
					; For example
					; 123 / 10 = 12.3
					; 12.3 / 10 = 1.23
					; 1.23 / 10 = 0, took 3 times to get quotient of 0, thus has 3 digits
 000000DB  89 0D 0000016A R		mov		loopCounter, ecx
 000000E1  BB 0000000A			mov		ebx, 10
 000000E6  B9 00000000			mov		ecx, 0
 000000EB			begDigitLoop:
 000000EB  99				cdq		
 000000EC  F7 F3			div		ebx
 000000EE  41				inc		ecx
 000000EF  83 F8 00			cmp		eax, 0
 000000F2  75 F7			jne		begDigitLoop
 000000F4			endDigitLoop:
 000000F4  89 0D 00000166 R		mov		termLength, ecx
 000000FA  8B 0D 0000016A R		mov		ecx, loopCounter

					; Print out empty spaces until the amount of digits in the term sum and 

 00000100  B8 0000000F			mov		eax, COLUMN_WIDTH
 00000105  2B 05 00000166 R		sub		eax, termLength
 0000010B			begSpaceLoop:
 0000010B  83 F8 00			cmp		eax, 0
 0000010E  74 0D			je		endSpaceLoop
 00000110  48				dec		eax
 00000111  BA 00000158 R		mov		edx, OFFSET spaceChar
 00000116  E8 00000000 E		call	WriteString
 0000011B  EB EE			jmp		begSpaceLoop
 0000011D			endSpaceLoop:

					; Print a new line after TERMS_PER_LINE terms have been printed
 0000011D  8B 1D 00000162 R		mov		ebx, termCount
 00000123  43				inc		ebx
 00000124  83 FB 05			cmp		ebx, TERMS_PER_LINE
 00000127  7C 0A			jl		endFibLoop
 00000129  E8 00000000 E		call	CrLf
 0000012E  BB 00000000			mov		ebx, 0
 00000133			endFibLoop:
 00000133  89 1D 00000162 R		mov		termCount, ebx
 00000139  E2 3E			loop	fibTmpLoop

					; Print newline if a full line of terms was not printed when

					; Valid user input for amount of fib terms is within bounds
 00000096  83 F8 01			cmp		eax, MIN_FIB_TERMS
 00000099  7C 07			jl		invalidTermsAmount
 0000009B  83 F8 2E			cmp		eax, MAX_FIB_TERMS

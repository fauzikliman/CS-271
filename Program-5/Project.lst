					; Generate a random number
 00000104  8B C3			mov		eax, ebx
 00000106  E8 00000000 E		call	RandomRange
 0000010B  83 C0 64			add		eax, MIN_ARRAY_NUM
 0000010E  89 45 FC			mov		randomNumber, eax

					; Prepare writing to file
 00000111  53				push	ebx
 00000112  51				push	ecx

					; Move address of the local variable thats going to contain
					; the data to be written to the file to ebx
 00000113  8B DD			mov		ebx, ebp
 00000115  83 EB 04			sub		ebx, 4

					; Write to file
 00000118  8B 45 F8			mov		eax, fileHandle
 0000011B  8B D3			mov		edx, ebx
 0000011D  B9 00000004			mov		ecx, 4
 00000122  E8 00000000 E		call	WriteToFile

					; Restore the loop counter and random range
 00000127  59				pop		ecx
 00000128  5B				pop		ebx

					; Loop for as many as array size and close the file once done
 00000129  E2 D9			loop	begWritingToFile
 0000012B  8B 45 F8			mov		eax, fileHandle
 0000012E  E8 00000000 E		call	CloseFile


 0000008A  61				popad
 0000008B  C3				ret
 0000008C			Introduction ENDP

				; Procedure to get the amount of numbers the user wants to be sorted
				; Recieves: address of variable to hold user input, invalidInputMsg is a global variable
				; Returns: variable passed in contains a valid array size
				; Preconditions: none
				; Registers changed: none
 0000008C			GetData PROC

					; Setup the stack frame and save all the registers
 0000008C  55				push	ebp
 0000008D  8B EC			mov		ebp, esp
 0000008F  60				pushad

					; Move the address of the array size parameter into edi
 00000090  8B 7D 08			mov		edi, [ebp + 8]

					; Prompt the user for the amount of numbers to sort
 00000093			begUserInput:
 00000093  BA 000001E9 R		mov		edx, OFFSET arraySizePrompt
 00000098  E8 00000000 E		call	WriteString
 0000009D  E8 00000000 E		call	ReadInt

					; Check that the input from the user is within the MIN and MAX for array size
 000000A2  83 F8 0A			cmp		eax, MIN_ARRAY_SIZE
 000000A5  7C 09			jl		invalidInput
 000000A7  3D 000000C8			cmp		eax, MAX_ARRAY_SIZE
 000000AC  7F 02			jg		invalidInput
 000000AE  EB 0C			jmp		endUserInput

					; Display user input invalid message and go to asking for user input again
 000000B0			invalidInput:
 000000B0  BA 0000021D R		mov		edx, OFFSET invalidInputMsg
 000000B5  E8 00000000 E		call	WriteString
 000000BA  EB D7			jmp		begUserInput

					; Valid input was given by th user, update the value in the parameter
 000000BC			endUserInput:
 000000BC  89 07			mov		[edi], eax
 000000BE  E8 00000000 E		call	CrLf

					; Clean up the stack frame restore all the registers
 000000C3  61				popad
 000000C4  5D				pop		ebp
 000000C5  C2 0004			ret		4
 000000C8			GetData ENDP


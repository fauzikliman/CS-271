				; Procedure to get the amount of numbers the user wants to be sorted
				; Recieves: address of variable to hold user input
				; Returns: variable passed in contains a valid array size
				; Preconditions: none
				; Registers changed: none
 00000082			GetData PROC

					; Setup the stack frame and save all the registers
 00000082  55				push	ebp
 00000083  8B EC			mov		ebp, esp
 00000085  60				pushad

					; Move the address of the array size parameter into edi
 00000086  8B 7D 08			mov		edi, [ebp + 8]

					; Prompt the user for the amount of numbers to sort
 00000089			begUserInput:
 00000089  BA 00000103 R		mov		edx, OFFSET arraySizePrompt
 0000008E  E8 00000000 E		call	WriteString
 00000093  E8 00000000 E		call	ReadInt

					; Check that the input from the user is within the MIN and MAX for array size
 00000098  83 F8 0A			cmp		eax, MIN_ARRAY_SIZE
 0000009B  7C 09			jl		invalidInput
 0000009D  3D 000000C8			cmp		eax, MAX_ARRAY_SIZE
 000000A2  7F 02			jg		invalidInput
 000000A4  EB 0C			jmp		endUserInput

					; Display user input invalid message and go to asking for user input again
 000000A6			invalidInput:
 000000A6  BA 00000137 R		mov		edx, OFFSET invalidInputMsg
 000000AB  E8 00000000 E		call	WriteString
 000000B0  EB D7			jmp		begUserInput

					; Valid input was given by th user, update the value in the parameter
 000000B2			endUserInput:
 000000B2  89 07			mov		[edi], eax
 000000B4  E8 00000000 E		call	CrLf

					; Clean up the stack frame restore all the registers
 000000B9  61				popad
 000000BA  5D				pop		ebp
 000000BB  C2 0004			ret		4
 000000BE			GetData ENDP

				; Procedure to generate an array with the amount of numbers the user entered
				; Recieves: address of DWORD array to fill, array size
				; Returns: array of length size filled with random numbers
				; Preconditions: none
				; Registers changed: none
 000000BEFillArray PROC
					
					; Setup the stack frame and save all the registers
 000000BE  55				push	ebp
 000000BF  8B EC			mov		ebp, esp
 000000C1  60				pushad

					; Move the address of the array parameter to edi
 000000C2  8B 7D 0C			mov		edi, [ebp + 12]
					
					; Move the value of the array size parameter to ecx for looping later
 000000C5  8B 4D 08			mov		ecx, [ebp + 8]
					
					; Calculate the random range for the RandomRange procedure to be (MAX - MIN + 1)
 000000C8  BB 000003E7			mov		ebx, MAX_ARRAY_NUM
 000000CD  83 EB 64			sub		ebx, MIN_ARRAY_NUM
 000000D0  43				inc		ebx

					; Fill the array with random numbers
 000000D1			begFill:
					; Set eax to the random range and generate random number into eax
 000000D1  8B C3			mov		eax, ebx
 000000D3  E8 00000000 E		call	RandomRange
 000000D8  83 C0 64			add		eax, MIN_ARRAY_NUM

					; Set current element in array to the random number
 000000DB  89 07			mov		[edi], eax

					; Move to next element in the array and repeat
 000000DD  83 C7 04			add		edi, 4
 000000E0  E2 EF			loop	begFill

					; Clean the stack frame and restore all the registers
 000000E2  61				popad
 000000E3  5D				pop		ebp
 000000E4  C2 0008			ret		8
 000000E7			FillArray ENDP

				; Procedure to sort the array recursively using quickSort
				; Recieves: address of DWORD array to fill, array size
				; Returns: none
				; Preconditions: none
				; Registers changed: none
 000000E7			SortList PROC

					; Setup the stack frame and save all registers
 000000E7  55				push	ebp
 000000E8  8B EC			mov		ebp, esp
 000000EA  60				pushad

					; Call the QuickSort procedure with the address of the array and the
					; start index, and end index. Start/End index are 0 based, thus why we're
					; subtracting 1 from the array size
 000000EB  8B 45 08			mov		eax, [ebp + 8]
 000000EE  48				dec		eax

 000000EF  FF 75 0C			push	[ebp + 12]
 000000F2  6A 00			push	0
 000000F4  50				push	eax
 000000F5  E8 0000006D			call	QuickSort

					; Clean the stack frame and restore all the registers
 000000FA  61				popad
 000000FB  5D				pop		ebp
 000000FC  C2 0008			ret		8
 000000FF			SortList ENDP

				; Procedure to swap two elements in a DWORD array
				; Recieves: address of DWORD array to fill, index A, index B
				; Returns: the elements in the array are swapped
				; Preconditions: start/end index are within the bounds of the array
				; Registers changed: none
 000000FF			SwapArrayElements PROC
					
					; Setup the stack fram and save all the registers
 000000FF  55				push	ebp
 00000100  8B EC			mov		ebp, esp
 00000102  60				pushad

					; Set the address of the array to edi
 00000103  8B 7D 10			mov		edi, [ebp + 16]
					
					; Move the index parameters to registers for indexing the array
 00000106  8B 4D 0C			mov		ecx, [ebp + 12]
 00000109  8B 55 08			mov		edx, [ebp + 8]

					; Move the values of the array into registers
 0000010C  8B 04 8F			mov		eax, [edi + ecx * 4]
 0000010F  8B 1C 97			mov		ebx, [edi + edx * 4]

					; Swap the elements of the array
 00000112  89 1C 8F			mov		[edi + ecx * 4], ebx
 00000115  89 04 97			mov		[edi + edx * 4], eax

					; Clean the stack frame and restore all the registers
 00000118  61				popad
 00000119  5D				pop		ebp
 0000011A  C2 000C			ret		12
 0000011D			SwapArrayElements ENDP

				; Procedure put the pivot point, the last element, in the correct position
				;	relative to the other elements, i.e. all elements greater
				;	than or equal to the pivot are placed to the left of it and all
				;	elements less than the pivot are placed to the right of it
				; Recieves: address of DWORD array to fill, start index, end index, address of variable to
				;	contain the index of the pivot
				; Returns: the index of the pivot
				; Preconditions: none
				; Registers changed: none
 0000011D			Partition PROC
					
					; Setup local variables and save all the registers
					LOCAL	pivot:DWORD
					LOCAL	pivotIndex:DWORD
 0000011D  55		   *	    push   ebp
 0000011E  8B EC	   *	    mov    ebp, esp
 00000120  83 C4 F8	   *	    add    esp, 0FFFFFFF8h
 00000123  60				pushad

					; Store the address of the array to be sorted into esi
 00000124  8B 75 14			mov		esi, [ebp + 20]

					; Use the ecx as the index counter, set it to starting index parameter
 00000127  8B 4D 10			mov		ecx, [ebp + 16]

					; Use edx as the end index
 0000012A  8B 55 0C			mov		edx, [ebp + 12]

					; Set the pivot to first element in array, pivot index to start index
 0000012D  8B 04 96			mov		eax, [esi + edx * 4]
 00000130  89 45 FC			mov		pivot, eax
 00000133  89 4D F8			mov		pivotIndex, ecx

					; Loop over each element, for elements greater than or equal to the pivot
					; swap the element and the pivot index, increment the pivot index
 00000136			begLoop:
					; Check if the current element is greater than or equal to the pivot
					; if so, swap the elements
 00000136  8B 04 8E			mov		eax, [esi + ecx * 4]
 00000139  3B 45 FC			cmp		eax, pivot
 0000013C  7C 0D			jl		endSwap

					; Swap the pivot index and current elem
 0000013E  56				push	esi			; address of the array
 0000013F  51				push	ecx			; current index
 00000140  FF 75 F8			push	pivotIndex	; pivot index
 00000143  E8 FFFFFFB7			call	SwapArrayElements
					
 00000148  FF 45 F8			inc		pivotIndex
 0000014B			endSwap:
 0000014B  41				inc		ecx
 0000014C  3B CA			cmp		ecx, edx
 0000014E  7C E6			jl		begLoop

					; Swap the pivot with the pivot index
 00000150  56				push	esi
 00000151  FF 75 F8			push	pivotIndex
 00000154  52				push	edx
 00000155  E8 FFFFFFA5			call	SwapArrayElements

					; Set the pivot index to the address of variable passed in
 0000015A  8B 7D 08			mov		edi, [ebp + 8]
 0000015D  8B 45 F8			mov		eax, pivotIndex
 00000160  89 07			mov		[edi], eax
					
					; Clean the stack frame and restore all the registers
 00000162  61				popad
 00000163  C9		   *	    leave  
 00000164  C2 0010			ret		16
 00000167			Partition ENDP

				; Procedure to sort the array recursively using quickSort
				; Recieves: address of DWORD array to fill, start index, end index
				; Returns: array is sorted in descending order
				; Preconditions: none
				; Registers changed: none
 00000167			QuickSort PROC

					; Setup local variables and save all the registers
					LOCAL	arrayAddress:DWORD
					LOCAL	lo:DWORD
					LOCAL	hi:DWORD
					LOCAL	pi:DWORD
 00000167  55		   *	    push   ebp
 00000168  8B EC	   *	    mov    ebp, esp
 0000016A  83 C4 F0	   *	    add    esp, 0FFFFFFF0h
 0000016D  60				pushad

					; Initialize the local variables to passed in parameters
 0000016E  8B 45 10			mov		eax, [ebp + 16]
 00000171  89 45 FC			mov		arrayAddress, eax

 00000174  8B 45 0C			mov		eax, [ebp + 12]
 00000177  89 45 F8			mov		lo, eax

 0000017A  8B 45 08			mov		eax, [ebp + 8]
 0000017D  89 45 F4			mov		hi, eax

					; Only recursively call quickSort if lo < hi
 00000180  8B 45 F8			mov		eax, lo
 00000183  3B 45 F4			cmp		eax, hi
 00000186  7D 34			jge		endSort

					; Get the address of the pi local variable
 00000188  8B C5			mov		eax, ebp
 0000018A  83 E8 10			sub		eax, 16

 0000018D  FF 75 FC			push	arrayAddress
 00000190  FF 75 F8			push	lo
 00000193  FF 75 F4			push	hi
 00000196  50				push	eax
 00000197  E8 FFFFFF81			call	Partition

					; Call quickSort with lo and pi - 1
 0000019C  8B 45 F0			mov		eax, pi
 0000019F  48				dec		eax

 000001A0  FF 75 FC			push	arrayAddress
 000001A3  FF 75 F8			push	lo
 000001A6  50				push	eax
 000001A7  E8 FFFFFFBB			call	QuickSort

					; Call quickSort with pi + 1 and hi
 000001AC  8B 45 F0			mov		eax, pi
 000001AF  40				inc		eax

 000001B0  FF 75 FC			push	arrayAddress
 000001B3  50				push	eax
 000001B4  FF 75 F4			push	hi
 000001B7  E8 FFFFFFAB			call	QuickSort

 000001BC			endSort:
					; Clean the stack frame and restore all the registers
 000001BC  61				popad
 000001BD  C9		   *	    leave  
 000001BE  C2 000C			ret		12
 000001C1			QuickSort ENDP

				; Procedure to display the median of the array
				; Recieves: address of DWORD array to fill, array size
				; Returns: none
				; Preconditions: the array is sorted in descending order
				; Registers changed: none
 000001C1			DisplayMedian PROC

					; Setup local variables and save all the registers
					LOCAL	median:DWORD
					LOCAL	divisor:REAL4
 000001C1  55		   *	    push   ebp
 000001C2  8B EC	   *	    mov    ebp, esp
 000001C4  83 C4 F8	   *	    add    esp, 0FFFFFFF8h
 000001C7  60				pushad

					; Move the address of the array to esi
 000001C8  8B 75 0C			mov		esi, [ebp + 12]

					; Display the median message
 000001CB  BA 0000017D R		mov		edx, OFFSET medianMsg
 000001D0  E8 00000000 E		call	WriteString

					; Move 2 into divisor so we can use it to divide the FPU
 000001D5  C7 45 F8			mov		divisor, 2
	   00000002

					; Calculate the middle index of the array where the median will be
 000001DC  8B 45 08			mov		eax, [ebp + 8]		; Move array size to eax for division
 000001DF  BB 00000002			mov		ebx, 2
 000001E4  99				cdq
 000001E5  F7 F3			div		ebx
 000001E7  8B C8			mov		ecx, eax			; Move median index to ecx

					; Push value in array to the FPU stack
 000001E9  DB 04 8E			FILD	DWORD PTR [esi + ecx * 4]

					; If there is a remainder of 0, it means that the array has an even number of
					; elements, so we need to add the 2 middle elements and average them, rounded to nearest
					; integer to get the median
 000001EC  83 FA 00			cmp		edx, 0
 000001EF  75 0B			jne		showMedian

					; Descrement ecx to the previous index in the array and push the value to the FPU stack
 000001F1  49				dec		ecx
 000001F2  DB 04 8E			FILD	DWORD PTR [esi + ecx * 4]

					; Add the two values in the FPU stack together and divide them by 2 to get the average
 000001F5  DE C1			FADD
 000001F7  DB 45 F8			FILD	divisor
 000001FA  DE F9			FDIV

					; Display the median
 000001FC			showMedian:
					; Round the median in the FPU stack to nearest integer and store it into median
 000001FC  DB 55 FC			FIST	median

					; Display the median
 000001FF  8B 45 FC			mov		eax, median
 00000202  E8 00000000 E		call	WriteDec
 00000207  BA 00000147 R		mov		edx, OFFSET periodChar
 0000020C  E8 00000000 E		call	WriteString
 00000211  E8 00000000 E		call	CrLf
 00000216  E8 00000000 E		call	CrLf

					; Clean the stack frame and restore all the registers
 0000021B  61				popad
 0000021C  C9		   *	    leave  
 0000021D  C2 0008			ret		8
 00000220			DisplayMedian ENDP

				; Displays the array
				; Procedure to display a message and an array
				; Recieves: address of DWORD array to display, array size, address of message to display
				; Returns: none
				; Preconditions: none
				; Registers changed: none
 00000220			DisplayList PROC

					; The idea behind printing the list in column order is to split the output
					; window into two sections. The first section will be N cols x M rows where N is the remainder
					; of the array size divided by the max numbers displayed per line. M is the quotient of
					; the array size divided by the max numbers displayed per line + 1. The second section will
					; be K cols x J rows where k is the max numbers displayed per line - N and J is the  quotient
					; of the array size. This so that within each section there is always a full row of data

					;	10	6	3
					;	9	5	2
					;	8	4	1
					;	7
					;
					;	Given following example,
					;	N = 1	Section 1 cols
					;	M = 4	Section 1 rows
					;	K = 2	Section 2 cols
					;	J = 3	Section 2 rows

					; Setup the local variables and save all the registers
					LOCAL	sec1Cols:DWORD				; N cols
					LOCAL	sec1Rows:DWORD				; M rows
					LOCAL	sec1ElemCount:DWORD			; Amount of elements in section 1
					LOCAL	sec2Rows:DWORD				; J rows
					LOCAL	rowNum:DWORD
					LOCAL	colNum:DWORD
					LOCAL	bytesPerElem:DWORD
					LOCAL	arrayAddress:DWORD
 00000220  55		   *	    push   ebp
 00000221  8B EC	   *	    mov    ebp, esp
 00000223  83 C4 E0	   *	    add    esp, 0FFFFFFE0h
 00000226  60				pushad

					; Bytes each element of DWORD array takes up
 00000227  C7 45 E4			mov		bytesPerElem, 4
	   00000004

					; Move the address of the array paremeter to arrayAddress
 0000022E  8B 75 10			mov		esi, [ebp + 16]
 00000231  89 75 E0			mov		arrayAddress, esi

					; Move the value of the array size paremeter to ecx for looping
 00000234  8B 4D 0C			mov		ecx, [ebp + 12]

					; Display the message that was passed in
 00000237  8B 55 08			mov		edx, [ebp + 8]
 0000023A  E8 00000000 E		call	WriteString

					; Calculate the amount rows of numbers that'll be printed for section 1 and 2
 0000023F  BB 0000000A			mov		ebx, NUM_PER_LINE
 00000244  8B C1			mov		eax, ecx			; ecx contains the size of the array
 00000246  99				cdq
 00000247  F7 F3			div		ebx
 00000249  89 45 F0			mov		sec2Rows, eax

					; Section 1 only exists if all the elements could not be displayed in full rows of
					; NUM_PER_LINE
 0000024C  83 FA 00			cmp		edx, 0
 0000024F  75 17			jne		setupSec1Data
					
					; Set sec1 data to 0 since all elements could be displayed in full rows of NUM_PER_LINE
 00000251  C7 45 F4			mov		sec1ElemCount, 0
	   00000000
 00000258  C7 45 FC			mov		sec1Cols, 0
	   00000000
 0000025F  C7 45 F8			mov		sec1Rows, 0
	   00000000
 00000266  EB 16			jmp		endSecDataCalc


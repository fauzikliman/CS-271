 000001F9  61				popad
 000001FA  C9		   *	    leave  
 000001FB  C2 0010			ret		16
 000001FE			Partition ENDP

				; Procedure to sort the array recursively using quickSort
				; Recieves: address of DWORD array to fill, start index, end index
				; Returns: array is sorted in descending order
				; Preconditions: none
				; Registers changed: none
 000001FE			QuickSort PROC

					; Setup local variables and save all the registers
					LOCAL	arrayAddress:DWORD
					LOCAL	lo:DWORD
					LOCAL	hi:DWORD
					LOCAL	pi:DWORD
 000001FE  55		   *	    push   ebp
 000001FF  8B EC	   *	    mov    ebp, esp
 00000201  83 C4 F0	   *	    add    esp, 0FFFFFFF0h
 00000204  60				pushad

					; Initialize the local variables to passed in parameters
 00000205  8B 45 10			mov		eax, [ebp + 16]
 00000208  89 45 FC			mov		arrayAddress, eax

 0000020B  8B 45 0C			mov		eax, [ebp + 12]
 0000020E  89 45 F8			mov		lo, eax

 00000211  8B 45 08			mov		eax, [ebp + 8]
 00000214  89 45 F4			mov		hi, eax

					; Only recursively call quickSort if lo < hi
 00000217  8B 45 F8			mov		eax, lo
 0000021A  3B 45 F4			cmp		eax, hi
 0000021D  7D 34			jge		endSort

					; Get the address of the pi local variable
 0000021F  8B C5			mov		eax, ebp
 00000221  83 E8 10			sub		eax, 16


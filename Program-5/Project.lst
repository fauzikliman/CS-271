				; Procedure to generate random numbers to the numbers file
				; Recieves: array size
				; Returns: none
				; Preconditions: none
				; Registers changed: none
 000000E4			GenerateNumbersToFile PROC

					; Setup local variables and save all the registers
					LOCAL	randomNumber:DWORD
					LOCAL	fileHandle:HANDLE
 000000E4  55		   *	    push   ebp
 000000E5  8B EC	   *	    mov    ebp, esp
 000000E7  83 C4 F8	   *	    add    esp, 0FFFFFFF8h
 000000EA  60				pushad

					; Calculate the random range for the RandomRange procedure to be (MAX - MIN + 1)
 000000EB  BB 000003E7			mov		ebx, MAX_ARRAY_NUM
 000000F0  83 EB 64			sub		ebx, MIN_ARRAY_NUM
 000000F3  43				inc		ebx

					; Create new text file to store the random numbers, CreateOutputFile
					; modifies the ecx register
 000000F4  BA 00000272 R		mov		edx, OFFSET numbersFilename
 000000F9  E8 00000000 E		call	CreateOutputFile
 000000FE  89 45 F8			mov		fileHandle, eax

					; Move the value of the array size parameter to ecx for looping later
 00000101  8B 4D 08			mov		ecx, [ebp + 8]

					; Begin writing random numbers to the file

 0000013A			DisplayList PROC

					; The idea behind printing the list in column order is to split the output
					; window into two sections. The first section will be N cols x M rows where N is the remainder
					; of the array size divided by the max numbers displayed per line. M is the quotient of
					; the array size divided by the max numbers displayed per line + 1. The second section will
					; be K cols x J rows where k is the max numbers displayed per line - N and J is the  quotient
					; of the array size. This so that within each section there is always a full row of data

					;	10	6	3
					;	9	5	2
					;	8	4	1
					;	7
					;
					;	Given following example,
					;	N = 1	Section 1 cols
					;	M = 4	Section 1 rows
					;	K = 2	Section 2 cols
					;	J = 3	Section 2 rows

					; Setup the local variables and save all the registers
					LOCAL	sec1Cols:DWORD				; N cols
					LOCAL	sec1Rows:DWORD				; M rows
					LOCAL	sec1ElemCount:DWORD			; Amount of elements in section 1
					LOCAL	sec2Rows:DWORD				; J rows
					LOCAL	rowNum:DWORD
					LOCAL	colNum:DWORD
					LOCAL	bytesPerElem:DWORD
					LOCAL	arrayAddress:DWORD
 0000013A  55		   *	    push   ebp
 0000013B  8B EC	   *	    mov    ebp, esp
 0000013D  83 C4 E0	   *	    add    esp, 0FFFFFFE0h
 00000140  60				pushad

					; Bytes each element of DWORD array takes up
 00000141  C7 45 E4			mov		bytesPerElem, 4
	   00000004

					; Move the address of the array paremeter to arrayAddress
 00000148  8B 75 10			mov		esi, [ebp + 16]
 0000014B  89 75 E0			mov		arrayAddress, esi

					; Move the value of the array size paremeter to ecx for looping
 0000014E  8B 4D 0C			mov		ecx, [ebp + 12]

					; Display the message that was passed in
 00000151  8B 55 08			mov		edx, [ebp + 8]
 00000154  E8 00000000 E		call	WriteString

					; Calculate the amount rows of numbers that'll be printed for section 1 and 2
 00000159  BB 0000000A			mov		ebx, NUM_PER_LINE
 0000015E  8B C1			mov		eax, ecx			; ecx contains the size of the array
 00000160  99				cdq
 00000161  F7 F3			div		ebx
 00000163  89 45 F0			mov		sec2Rows, eax

					; Section 1 only exists if all the elements could not be displayed in full rows of
					; NUM_PER_LINE
 00000166  83 FA 00			cmp		edx, 0
 00000169  75 17			jne		setupSec1Data
					
					; Set sec1 data to 0 since all elements could be displayed in full rows of NUM_PER_LINE
 0000016B  C7 45 F4			mov		sec1ElemCount, 0
	   00000000
 00000172  C7 45 FC			mov		sec1Cols, 0
	   00000000
 00000179  C7 45 F8			mov		sec1Rows, 0
	   00000000
 00000180  EB 16			jmp		endSecDataCalc

 00000182			setupSec1Data:
					; Set sec1Rows to sec2Rows + 1, and sec1Cols to the remainder of array size divided by NUM_PER_LINE
 00000182  8B 45 F0			mov		eax, sec2Rows
 00000185  40				inc		eax
 00000186  89 45 F8			mov		sec1Rows, eax
 00000189  89 55 FC			mov		sec1Cols, edx

					; Set the amount of elements in section 1
 0000018C  8B 45 FC			mov		eax, sec1Cols
 0000018F  F7 65 F8			mul		sec1Rows
 00000192  F7 65 E4			mul		bytesPerElem
 00000195  89 45 F4			mov		sec1ElemCount, eax

 00000198			endSecDataCalc:
					; Prepare printing the array by column
 00000198  C7 45 EC			mov		rowNum, 0				; will contain the row number we're on starting at 0
	   00000000
 0000019F  C7 45 E8			mov		colNum, 0				; will contain the col number we're on starting at 0
	   00000000

 000001A6			begDisplayList:
					; Print newline if we've displayed the maximum amount of numbers per row
 000001A6  83 7D E8 0A			cmp		colNum, NUM_PER_LINE
 000001AA  7C 0F			jl		endDisplayNewline
 000001AC  E8 00000000 E		call	CrLf
 000001B1  FF 45 EC			inc		rowNum					; increment row number
 000001B4  C7 45 E8			mov		colNum, 0				; reset col number
	   00000000

 000001BB			endDisplayNewline:
 000001BB  8B 45 E8			mov		eax, colNum
 000001BE  3B 45 FC			cmp		eax, sec1Cols
 000001C1  8B 75 E0			mov		esi, arrayAddress
 000001C4  7D 10			jge		sec2Area

					; We're displaying values to the section 1 area of the output
					; To display in section 1 we multiply the current col num by the 
					; amount of rows in section 1 and add the row num as the offset
 000001C6  8B 45 E8			mov		eax, colNum
 000001C9  F7 65 F8			mul		sec1Rows
 000001CC  03 45 EC			add		eax, rowNum
 000001CF  F7 65 E4			mul		bytesPerElem
 000001D2  03 F0			add		esi, eax
 000001D4  EB 14			jmp		displayArrayValue

 000001D6			sec2Area:
					; We're displaying values to the section 2 area of the output
					; To display in section 2 we get difference between the current col num
					; and the amount of cols in section 1, multipy that by the amount of rows
					; in section 2 and add the row num as the offset, then add the amount elems
					; that exist in section 1 before section 2
 000001D6  8B 45 E8			mov		eax, colNum
 000001D9  2B 45 FC			sub		eax, sec1Cols
 000001DC  F7 65 F0			mul		sec2Rows
 000001DF  03 45 EC			add		eax, rowNum
 000001E2  F7 65 E4			mul		bytesPerElem
 000001E5  03 45 F4			add		eax, sec1ElemCount
 000001E8  03 F0			add		esi, eax

 000001EA			displayArrayValue:
					; Display the value in the array
 000001EA  8B 06			mov		eax, [esi]
 000001EC  E8 00000000 E		call	WriteDec
					
					; Display spaces after each number=
 000001F1  BA 00000149 R		mov		edx, OFFSET numberPaddingMsg
 000001F6  E8 00000000 E		call	WriteString

					; Increment col number and number of numbers we've displayed
 000001FB  FF 45 E8			inc		colNum

					; Loop printing the array values
 000001FE  E2 A6			loop	begDisplayList
 00000200  E8 00000000 E		call	CrLf

					; Restore all the registers
 00000205  61				popad
 00000206  C9		   *	    leave  
 00000207  C2 000C			ret		12
 0000020A			DisplayList ENDP


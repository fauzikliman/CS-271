 000000F9  8B C2			mov		eax, edx
 000000FB  BB 0000000A			mov		ebx, 10
 00000100  F7 E3			mul		ebx
 00000102  8B 1D 00000004 R		mov		ebx, num2
 00000108  99				cdq
 00000109  F7 F3			div		ebx
 0000010B  83 F8 05			cmp		eax, 5 ; eax is (((remainder * divPrecision) % num2) * 10) / num2
 0000010E  7C 06			jl		afterRounding
 00000110  FF 05 00000255 R		inc		fractional

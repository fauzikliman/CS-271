					; Init local variables
 00000061  C7 45 FC			mov		tmpBufferSize, 80
	   00000050
 00000068  C6 45 FB 00			mov		tmpBuffer[79], 0
 0000006C  C7 45 A4			mov		parsedNumberFactor, 10
	   0000000A

					; Move address of tmp buffer to edi
 00000073  8D 7D AC			lea		edi, tmpBuffer

					; Set direction flag to forward for when we're parsing the string
 00000076  FC				cld

 00000077			_promptNumber:
					; Get user input, pass in number prompt, address of tmp buffer, size of tmp buffer
					mGetString [ebp + 20], edi, tmpBufferSize
 00000077  52		     2		push	edx

 0000010E  5A		     1		pop		edx
 0000010F  59		     1		pop		ecx
 00000110  EB 22			jmp		_parseNumber

 00000112			_invalidPromptNumber:
					; Display invalid number error, pass in invalid number message
					mDisplayString [ebp + 12]
 00000112  52		     1		push	edx
 00000113  8B 55 0C	     1		mov		edx, [ebp + 12]
 00000116  E8 00000000 E     1		call	WriteString

 000000AC  E8 00000000 E     1		call	ReadString
 000000B1  5A		     1		pop		edx
 000000B2  59		     1		pop		ecx

 000000B3			_parseNumber:
					; Init parsed number to 0
 000000B3  C7 45 A8			mov		parsedNumber, 0
	   00000000

					; Init number of digits processed to 0
 000000BA  B9 00000000			mov		ecx, 0

					; Move address of tmp buffer to esi
 000000BF  8B F7			mov		esi, edi

 000000C1			_begParseLoop:
					; Get current character byte in tmp buffer to al and move it currentChar
 000000C1  AC				lodsb
 000000C2  88 45 A0			mov		BYTE PTR currentChar, al

					; Check if current character is 0, if so it means we're done
 000000C5  83 7D A0 00			cmp		currentChar, 0
 000000C9  74 24			je		_endParseNumber

					; Check if current character is a valid digit, 48 = 0, 57 = 9, if not its invalid then
 000000CB  83 7D A0 30			cmp		currentChar, 48
 000000CF  7C C0			jl		_invalidPromptNumber
 000000D1  83 7D A0 39			cmp		currentChar, 57
 000000D5  7F BA			jg		_invalidPromptNUmber

					; Else its a valid digit, multiply the current parsed number by 10 and add the current character
					; as a digit by subtractin 48 (0) from it
 000000D7  8B 45 A8			mov		eax, parsedNumber
 000000DA  F7 65 A4			mul		parsedNumberFactor

					; If the parsed number is too big, its invalid
 000000DD  72 B2			jc		_invalidPromptNumber

					; Convert current character to digit by subtracting 48 (0) from it
 000000DF  8B 5D A0			mov		ebx, currentChar
 000000E2  83 EB 30			sub		ebx, 48

					; Add the current digit to the parsed number
 000000E5  03 C3			add		eax, ebx

					; If the parsed number is too big, its invalid
 000000E7  72 A8			jc		_invalidPromptNumber

					; Update the parsed number variable and the amount of digits we've processed
 000000E9  89 45 A8			mov		parsedNumber, eax
 000000EC  41				inc		ecx

					; Loop again to the next character
 000000ED  EB D2			jmp		_begParseLoop

 000000EF			_endParseNumber:
					; If we didn't parse any digits, that means the user just pressed enter
 000000EF  83 F9 00			cmp		ecx, 0
 000000F2  74 9D			je		_invalidPromptNumber

					; Move the parsed number into the address of the passed in variable to contain it
 000000F4  8B 45 A8			mov		eax, parsedNumber
 000000F7  8B 7D 08			mov		edi, [ebp + 8]
 000000FA  89 07			mov		[edi], eax

					; Cleanup stack and restore all registers
 000000FC  61				popad
 000000FD  C9		   *	    leave  
 000000FE  C2 0010			ret		16
 00000101			ReadVal ENDP

				; Procedure to write the number passed in to the user
				; Recieves: number value to be displayed to the user
				; Returns: none
				; Preconditions: variable contains a number
				; Registers changed: none
 00000101			WriteVal PROC
					; Setup local variables and save all registers
					LOCAL	numStrSize:DWORD
					LOCAL	numStr[40]:BYTE
					LOCAL	numDivisor:DWORD
 00000101  55		   *	    push   ebp
 00000102  8B EC	   *	    mov    ebp, esp
 00000104  83 C4 D0	   *	    add    esp, 0FFFFFFD0h
 00000107  60				pushad

					; Init numStrSize and numDivisor
 00000108  C7 45 FC			mov		numStrSize, 40
	   00000028
 0000010F  C7 45 D0			mov		numDivisor, 10
	   0000000A

					; Move value of variable to eax
 00000116  8B 45 08			mov		eax, [ebp + 8]

					; Move the address of the numStr to edi
 00000119  8D 7D D4			lea		edi, numStr

					; Set ecx to numStrSize - 1 for looping, numStrSize - 1 because the last element will
					; be the null terminating character
 0000011C  8B 4D FC			mov		ecx, numStrSize
 0000011F  49				dec		ecx

					; Repeatedly divide the number by 10 to get each digit in the number,
					; convert that digit to ascii to get the text representation, and store 
					; it in the numStr byte array
 00000120			_begAsciiConversion:
					; Divide the number by 10, the remainder will be the right most digit
 00000120  99				cdq
 00000121  F7 75 D0			div		numDivisor

					; Move remainder to ebx to convert to ascii by adding 48 (0) to it
 00000124  8B DA			mov		ebx, edx
 00000126  83 C3 30			add		ebx, 48

					; Move the ascii number (ebx) to numStr and set edi to the next element
 00000129  89 1F			mov		[edi], ebx
 0000012B  47				inc		edi

					; If the quotient is 0, that means we're done looping for digits
 0000012C  83 F8 00			cmp		eax, 0
 0000012F  74 02			je		_endAsciiConversion

 00000131  E2 ED			loop	_begAsciiConversion

 00000133			_endAsciiConversion:
					; Set the last element to 0 for null character
 00000133  B8 00000000			mov		eax, 0
 00000138  89 07			mov		[edi], eax

					; Move the address of the first element to esi and decrement edi
					; to get the last digit element
 0000013A  8D 75 D4			lea		esi, numStr
 0000013D  4F				dec		edi

					; The order of the digits in the numStr is reversed because of
					; how we got the digits, so we need to reverse it normal
 0000013E			_begSwapElements:
					; Swap the beg and end elements and move inwards
 0000013E  8A 06			mov		al, [esi]
 00000140  8A 1F			mov		bl, [edi]
 00000142  88 1E			mov		[esi], bl
 00000144  88 07			mov		[edi], al

					; Increment esi and decrement edi
 00000146  46				inc		esi
 00000147  4F				dec		edi

					; If esi is greater than or equal to edi then we don't need swap anymore
 00000148  3B F7			cmp		esi, edi
 0000014A  7D 02			jge		_endSwapElements
 0000014C  EB F0	jmp		_begSwapElements

 0000014E			_endSwapElements:
					;; Display the number to the user
 0000014E  8D 75 D4			lea		esi, numStr
					mDisplayString esi
 00000151  52		     1		push	edx
 00000152  8B D6	     1		mov		edx, esi
 00000154  E8 00000000 E     1		call	WriteString
 00000159  5A		     1		pop		edx

					; Cleanup stack and restore all registers
 0000015A  61				popad

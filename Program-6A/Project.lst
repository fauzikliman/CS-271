 00000132  5A		     1		pop		edx
 00000133  59		     1		pop		ecx

 00000134			_parseNumber:
					; Init parsed number to 0
 00000134  C7 45 A8			mov		parsedNumber, 0
	   00000000

					; Init number of digits processed to 0
 0000013B  B9 00000000			mov		ecx, 0

					; Move address of tmp buffer to esi
 00000140  8B F7			mov		esi, edi

 00000142			_begParseLoop:
					; Get current character byte in tmp buffer to al and move it currentChar
 00000142  AC				lodsb
 00000143  88 45 A0			mov		BYTE PTR currentChar, al

					; Check if current character is 0, if so it means we're done
 00000146  83 7D A0 00			cmp		currentChar, 0
 0000014A  74 24			je		_endParseNumber

					; Check if current character is a valid digit, 48 = 0, 57 = 9, if not its invalid then
 0000014C  83 7D A0 30			cmp		currentChar, 48
 00000150  7C C0			jl		_invalidPromptNumber
 00000152  83 7D A0 39			cmp		currentChar, 57
 00000156  7F BA			jg		_invalidPromptNUmber

					; Else its a valid digit, multiply the current parsed number by 10 and add the current character
					; as a digit by subtractin 48 (0) from it
 00000158  8B 45 A8			mov		eax, parsedNumber
 0000015B  F7 65 A4			mul		parsedNumberFactor

					; If the parsed number is too big, its invalid
 0000015E  72 B2			jc		_invalidPromptNumber

					; Convert current character to digit by subtracting 48 (0) from it
 00000160  8B 5D A0			mov		ebx, currentChar
 00000163  83 EB 30			sub		ebx, 48

					; Add the current digit to the parsed number
 00000166  03 C3			add		eax, ebx

					; If the parsed number is too big, its invalid
 00000168  72 A8			jc		_invalidPromptNumber

					; Update the parsed number variable and the amount of digits we've processed
 0000016A  89 45 A8			mov		parsedNumber, eax
 0000016D  41				inc		ecx

					; Loop again to the next character
 0000016E  EB D2			jmp		_begParseLoop

 00000170			_endParseNumber:
					; If we didn't parse any digits, that means the user just pressed enter
 00000170  83 F9 00			cmp		ecx, 0
 00000173  74 9D			je		_invalidPromptNumber

					; Move the parsed number into the address of the passed in variable to contain it
 00000175  8B 45 A8			mov		eax, parsedNumber
 00000178  8B 7D 08			mov		edi, [ebp + 8]
 0000017B  89 07			mov		[edi], eax


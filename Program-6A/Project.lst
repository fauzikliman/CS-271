 000000E2  C7 45 FC			mov		tmpBufferSize, 80
	   00000050
 000000E9  C6 45 FB 00			mov		tmpBuffer[79], 0
 000000ED  C7 45 A4			mov		parsedNumberFactor, 10
	   0000000A

					; Move address of tmp buffer to edi
 000000F4  8D 7D AC			lea		edi, tmpBuffer

					; Set direction flag to forward for when we're parsing the string
 000000F7  FC				cld

 000000F8			_promptNumber:
					; Get user input, pass in number prompt, address of tmp buffer, size of tmp buffer
					mGetString [ebp + 20], edi, tmpBufferSize
 000000F8  52		     2		push	edx
 000000F9  8B 55 14	     2		mov		edx, [ebp + 20]
 000000FC  E8 00000000 E     2		call	WriteString
